# PostgreSQL connection string
POSTGRES_URI_STRING=""

# API key for Gemini
GEMINI_API_KEY=""

# Secret key for Flask session 
FLASK_SECRET_KEY=''

# Google OAuth credentials
CLIENT_ID=""
PROJECT_ID=""
CLIENT_SECRET=""

# Redis connection info
REDIS_HOST='redis'
REDIS_PORT=6379
REDIS_DB=0

# Allows OAuth scopes to be looser than requested
OAUTHLIB_RELAX_TOKEN_SCOPE=1
# Lets OAuth run over http instead of https
OAUTHLIB_INSECURE_TRANSPORT=1

# The port, host, and protocol the Flask app runs on
PORT=5000
HOST=0.0.0.0
APPLICATION_LAYER_PROTOCOL=http

# Enables Flask debug mode
DEBUG=True